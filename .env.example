# BLUSWAN configuration — variable NAMES only. Never commit real values.
#
# Server-side (read by `npm run server` / `npm run agent`; never exposed to the browser).
# Do NOT prefix provider secrets with VITE_: Vite compiles VITE_ variables into the public bundle, and BLUSWAN ignores them.

# ── Model providers (configure the ones you use) ─────────────────────────────
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=
DEEPSEEK_BASE_URL=https://api.deepseek.com

KIMI_API_KEY=
KIMI_MODEL=
KIMI_BASE_URL=https://api.moonshot.ai/v1

OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_BASE_URL=https://api.openai.com/v1

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
ANTHROPIC_BASE_URL=https://api.anthropic.com

# ── Server ───────────────────────────────────────────────────────────────────
# BLUSWAN_PORT=8787
# BLUSWAN_HOST=127.0.0.1
# BLUSWAN_AUTH=none                 # none: one local user, loopback only | firebase: verify Firebase ID tokens
# FIREBASE_PROJECT_ID=              # required when BLUSWAN_AUTH=firebase
# BLUSWAN_PERSISTENCE=file          # file | memory | firebase (firebase needs the firebase-admin package + credentials)
# BLUSWAN_DATA_DIR=.bluswan/data
# BLUSWAN_WORKSPACE_ROOTS=/path/to/projects   # colon-separated; repositories may only be opened below these (required with auth)
# BLUSWAN_HOST_ID=                  # stable name of this host (defaults to the hostname)
# BLUSWAN_CORS_ORIGIN=              # only if the web app is served from a different origin

# ── Web app (public values only) ─────────────────────────────────────────────
# VITE_BLUSWAN_API_URL=             # base URL of the BLUSWAN server when it is not the same origin
# Firebase web config, needed only when the server uses BLUSWAN_AUTH=firebase:
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_AUTH_DOMAIN=
# VITE_FIREBASE_PROJECT_ID=
# VITE_FIREBASE_APP_ID=

# ── Tuning (non-secret; defaults in src/config/runtimeConfig.js) ─────────────
# VITE_BLUSWAN_MAX_TURNS=25
# VITE_BLUSWAN_PERMISSION_MODE=auto_edit      # ask | auto_edit | full_auto
# VITE_BLUSWAN_REQUEST_TIMEOUT_MS=60000
# VITE_BLUSWAN_STREAM_TIMEOUT_MS=60000
