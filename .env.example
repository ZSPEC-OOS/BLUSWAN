# BLUSWAN configuration — variable NAMES only. Never commit real values. Example values for local use are in docs/DEPLOYMENT.md.
#
# Everything here is read by the RUNTIME (`npm run server` / `npm run agent`) and never reaches the browser.
# The only variables compiled into the web app are the three public ones in the last section.
# Do NOT prefix secrets or tuning with VITE_: Vite publishes VITE_ variables in the bundle, and BLUSWAN ignores them for the runtime.

# ── Model providers (configure the ones you use) ─────────────────────────────
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=
DEEPSEEK_BASE_URL=

KIMI_API_KEY=
KIMI_MODEL=
KIMI_BASE_URL=

OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_BASE_URL=

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
ANTHROPIC_BASE_URL=

# ── Runtime: network and identity ────────────────────────────────────────────
# BLUSWAN_PORT=               # listen port (default 8787)
# BLUSWAN_HOST=               # listen address (default 127.0.0.1; use 0.0.0.0 only with BLUSWAN_AUTH=firebase behind HTTPS)
# BLUSWAN_AUTH=               # none: one local user, loopback only | firebase: verify Firebase ID tokens
# FIREBASE_PROJECT_ID=        # required with BLUSWAN_AUTH=firebase or BLUSWAN_PERSISTENCE=firebase
# BLUSWAN_ALLOW_NO_AUTH=      # 1 = accept NODE_ENV=production without authentication on a private host (not recommended)
# BLUSWAN_CORS_ORIGIN=        # split-origin only: the ONE web origin allowed to call the runtime, e.g. https://app.example.com
# BLUSWAN_STATIC_DIR=         # same-origin without a proxy: serve this built web app (dist/) from the runtime itself
# BLUSWAN_LOG_REQUESTS=       # 0 = silence the one-line request log

# ── Runtime: storage and workspaces ──────────────────────────────────────────
# BLUSWAN_PERSISTENCE=        # file (default) | memory | firebase (Firestore; needs firebase-admin and Google credentials)
# BLUSWAN_DATA_DIR=           # file persistence directory (default .bluswan/data)
# BLUSWAN_WORKSPACE_ROOTS=    # path-separated list of folders repositories may be opened under (required with auth / production); GitHub clones go here, so use durable storage
# BLUSWAN_HOST_ID=            # stable name of this machine (defaults to the hostname)
# GOOGLE_APPLICATION_CREDENTIALS=   # Firestore credentials file, when BLUSWAN_PERSISTENCE=firebase

# ── GitHub App (optional; all of the first five, or none) — see docs/GITHUB.md ──
# GITHUB_APP_ID=
# GITHUB_APP_PRIVATE_KEY=         # PEM text (\n escapes accepted)
# GITHUB_APP_CLIENT_ID=
# GITHUB_APP_CLIENT_SECRET=
# GITHUB_APP_SLUG=
# GITHUB_APP_WEBHOOK_SECRET=      # optional: enables signed webhooks at /api/github/webhook
# GITHUB_API_URL=                 # GitHub Enterprise Server only
# GITHUB_WEB_URL=

# ── Runtime: agent tuning (non-secret; defaults in src/config/runtimeConfig.js) ──
# BLUSWAN_PERMISSION_MODE=        # ask | auto_edit | full_auto — the default for new users; each user's choice is stored server-side
# BLUSWAN_MAX_TURNS=
# BLUSWAN_MAX_RECOVERY_ROUNDS=
# BLUSWAN_REQUEST_TIMEOUT_MS=     # one provider request
# BLUSWAN_STREAM_TIMEOUT_MS=      # silence on a provider stream
# BLUSWAN_PROVIDER=               # default provider for new sessions
# BLUSWAN_MODEL=                  # default model for new sessions
# BLUSWAN_DEV_LOGGING=

# ── Diagnostics (npm run doctor) ─────────────────────────────────────────────
# BLUSWAN_API_URL=                # where doctor looks for the runtime (defaults to BLUSWAN_HOST:BLUSWAN_PORT)
# BLUSWAN_DOCTOR_TOKEN=           # a Firebase ID token, only to let doctor check the event stream on an authenticated runtime

# ── Web app build (public values only; compiled into the bundle) ─────────────
# VITE_BLUSWAN_API_URL=           # split-origin only: absolute https URL of the runtime. Leave unset for same-origin.
# VITE_FIREBASE_API_KEY=          # Firebase web config — needed only when the runtime uses BLUSWAN_AUTH=firebase
# VITE_FIREBASE_AUTH_DOMAIN=
# VITE_FIREBASE_PROJECT_ID=
# VITE_FIREBASE_APP_ID=
