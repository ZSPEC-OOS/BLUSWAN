{
  "name": "bluswan",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node --test \"src/protocol/*.test.mjs\" \"src/providers/*.test.mjs\" \"src/agent/*.test.mjs\" \"src/workspace/*.test.mjs\" \"src/tools/*.test.mjs\" \"src/context/*.test.mjs\" \"src/validation/*.test.mjs\" \"src/client/*.test.mjs\" \"src/client/*/*.test.mjs\" \"src/persistence/*.test.mjs\" \"src/sessions/*.test.mjs\" \"src/server/*.test.mjs\" \"src/core-v2/tests/*.test.mjs\" \"src/components-v2/tests/*.test.mjs\" \"tests/unit/*.test.mjs\"",
    "test:validation": "node --test \"src/validation/*.test.mjs\" \"src/agent/completion.test.mjs\" \"src/agent/phase5.integration.test.mjs\"",
    "test:context": "node --test \"src/context/*.test.mjs\" \"src/agent/phase4.integration.test.mjs\"",
    "test:agent": "node --test \"src/agent/*.test.mjs\" \"src/providers/*.test.mjs\" \"src/client/*.test.mjs\" \"src/client/*/*.test.mjs\"",
    "test:client": "node --test \"src/client/*.test.mjs\" \"src/client/*/*.test.mjs\" \"src/agent/permissions.test.mjs\"",
    "test:diff": "node --test \"src/client/workspace/diffParser.test.mjs\" \"src/agent/workspaceReview.test.mjs\"",
    "test:workspace-ui": "node --test \"src/client/workspace/workspace.test.mjs\" \"src/client/phase7.integration.test.mjs\"",
    "test:persistence": "node --test \"src/persistence/*.test.mjs\" \"src/sessions/*.test.mjs\"",
    "test:server": "node --test \"src/server/*.test.mjs\" \"src/client/runtime/*.test.mjs\"",
    "server": "node scripts/server.mjs",
    "test:deepseek": "node scripts/deepseek-smoke.mjs",
    "agent": "node scripts/agent.mjs",
    "test:workspace": "node --test \"src/workspace/*.test.mjs\"",
    "test:tools": "node --test \"src/tools/*.test.mjs\" \"src/agent/phase2.integration.test.mjs\"",
    "test:unit": "node --test tests/unit/*.test.mjs",
    "test:integration": "node --test tests/integration/*.test.mjs",
    "test:benchmark": "node tests/benchmarks/benchmarkRunner.mjs",
    "test:chaos": "node tests/chaos/chaosEngine.mjs",
    "test:all": "npm run test:unit && npm run test:integration && npm run test:benchmark && npm run test:chaos",
    "test:metrics": "node tests/metrics/collector.mjs",
    "benchmark:nightly": "node scripts/run-benchmarks.mjs",
    "cli": "node src/cli/bluswan-cli.mjs",
    "lint": "eslint src/"
  },
  "dependencies": {
    "diff": "8.0.3",
    "firebase": "12.10.0",
    "ogl": "1.0.11",
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "devDependencies": {
    "@eslint/js": "9.0.0",
    "@vitejs/plugin-react": "5.1.1",
    "eslint": "9.39.4",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.0.1",
    "globals": "17.4.0",
    "vite": "7.3.1"
  }
}
